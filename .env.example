ARTICLE_BUILDER_DATABASE_PATH=.data/article-builder.sqlite
BUILDER_UPLOAD_DIRECTORY=.data/uploads
# Ignored in production. Set false to exercise fail-closed auth locally.
BUILDER_ALLOW_UNAUTHENTICATED_DEVELOPMENT=true

# Development provider. Use cohere for the executive demo.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=News Article Content Builder
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026

# Optional development-only baseline for an article without a Builder Chat.
BUILDER_DEVELOPMENT_INITIAL_ARTICLE_HTML=
